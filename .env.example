# ===== Just-Bolg Django 环境配置 =====
# 复制本文件为 .env 后填写；.env 已被 .gitignore 忽略
# 注意：当前 settings.py 是硬编码（SECRET_KEY/DEBUG），
# 接入环境变量前请先按结构改进建议修改 settings.py

# Django 密钥（必须替换为随机长字符串）
SECRET_KEY=your-secret-key

# 调试开关（生产必须为 0）
DEBUG=1

# 允许访问的主机（逗号分隔）
ALLOWED_HOSTS=127.0.0.1,localhost

# 默认 SQLite 无需填写 DATABASE_URL；切换 PostgreSQL 时：
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/blog
DATABASE_URL=
